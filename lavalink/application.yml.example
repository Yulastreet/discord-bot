server:
  port: 2333
  address: 127.0.0.1
  http2:
    enabled: false

plugins:
  youtube:
    enabled: true
    # Clients YouTube essayes dans l'ordre. WEB/WEBEMBEDDED utilisent l'OAuth
    # (refreshToken ci-dessous) -> contournent "Sign in to confirm" et le 400.
    # ANDROID_VR/IOS retires : exigent un login non couvert par l'OAuth (echec 400).
    clients:
      - WEB
      - WEBEMBEDDED
      - MWEB
      - MUSIC
      - TVHTML5EMBEDDED
      - ANDROID_MUSIC
    # OAuth obligatoire : sans refreshToken, WEB renvoie "requires login" / 400.
    # Token obtenu au 1er lancement (oauth.enabled true sans token -> code device
    # dans les logs). Voir lavalink/README.md.
    oauth:
      enabled: true
      refreshToken: "COLLE_TON_REFRESH_TOKEN_ICI"
      skipInitialization: true

lavalink:
  plugins:
    # Plugin youtube-source (remplace le support YT natif retire de Lavalink).
    # Verifie la derniere version : https://github.com/lavalink-devs/youtube-source/releases
    - dependency: "dev.lavalink.youtube:youtube-plugin:1.18.1"
      snapshot: false
  server:
    # MOT DE PASSE : doit matcher LAVALINK_PASSWORD dans le .env du bot.
    password: "${LAVALINK_PASSWORD:youshallnotpass}"
    sources:
      # YouTube gere par le plugin youtube-source, pas le source natif.
      youtube: false
      bandcamp: true
      soundcloud: true
      twitch: true
      vimeo: true
      http: true
      local: false
    filters:
      volume: true
      equalizer: true
      karaoke: true
      timescale: true
      tremolo: true
      vibrato: true
      distortion: true
      rotation: true
      channelMix: true
      lowPass: true
    bufferDurationMs: 400
    frameBufferDurationMs: 5000
    opusEncodingQuality: 10
    resamplingQuality: HIGH
    trackStuckThresholdMs: 10000
    youtubePlaylistLoadLimit: 6
    playerUpdateInterval: 5
    youtubeSearchEnabled: true
    soundcloudSearchEnabled: true

metrics:
  prometheus:
    enabled: false

logging:
  level:
    root: INFO
    lavalink: INFO
  file:
    path: ./logs/
    max-history: 7
    max-size: 25MB
