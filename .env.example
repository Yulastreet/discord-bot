# ============================================================================
#  .env.example — copie en .env et remplis avec tes vraies valeurs.
#  Le .env est gitignoré, ne jamais commiter !
# ============================================================================

# ---------- Bot Discord ----------
DISCORD_TOKEN=ton_token_bot_discord_ici

# ---------- Web Dashboard — Authentification ----------

# Mode 1 : OAuth Discord (recommandé)
# Crée une app sur https://discord.com/developers/applications
# Onglet OAuth2 → Redirects → ajoute https://dashboard.tondomaine.fr/oauth/callback
# Copie le Client ID et Client Secret ici.
DISCORD_CLIENT_ID=ton_client_id_oauth
DISCORD_CLIENT_SECRET=ton_client_secret_oauth
OAUTH_REDIRECT_URI=https://dashboard.tondomaine.fr/oauth/callback

# Ton ID Discord personnel = super-admin (accès total au dashboard).
# Pour l'obtenir : Discord → Paramètres → Avancé → Mode développeur ON
# puis clic droit sur ton avatar → Copier l'ID.
DISCORD_OWNER_ID=ton_user_id_discord

# Mode 2 (fallback) : Password unique. Utilisé seulement si OAuth pas configuré.
# Tout user qui se logge ainsi est traité comme owner.
WEB_PASSWORD=fallback_password_robuste

# ---------- Sécurité Flask ----------

# Clé secrète des sessions (32+ chars random).
# Génération : `openssl rand -hex 32`
FLASK_SECRET=remplace_moi_par_32_caracteres_aleatoires_minimum

# Durée d'une session web (heures).
SESSION_LIFETIME_HOURS=24

# Mettre 1 si derrière nginx + HTTPS Let's Encrypt.
HTTPS_ENABLED=0

# Flask debug — JAMAIS 1 en prod.
FLASK_DEBUG=0

# ---------- Monétisation Discord SKU ----------
# Crée tes SKUs dans le Developer Portal -> ton App -> Monétisation -> SKU
# puis copie ici les IDs (longue suite de chiffres).
#
# /niveau Premium : SKU type "Durable" (achat unique, 1,99 USD)
SKU_NIVEAU_PREMIUM=

# Battle Pass : SKU type "Subscription" (récurrent mensuel, 3,99 EUR)
SKU_PASS=

# Token API top.gg (optionnel, sert au widget custom landing).
TOPGG_TOKEN=
