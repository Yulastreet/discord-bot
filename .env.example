# ============================================================================
#  .env.example — copie en .env et remplis avec tes vraies valeurs.
#  Le .env est gitignoré, ne jamais commiter !
# ============================================================================

# ---------- Bot Discord ----------
DISCORD_TOKEN=ton_token_bot_discord_ici

# ---------- Web Dashboard ----------
# Mot de passe d'accès (login dashboard)
WEB_PASSWORD=changeMe_avec_un_truc_robuste

# Clé secrète des sessions Flask (32+ caractères aléatoires).
# Génération : `openssl rand -hex 32` ou `python -c "import secrets; print(secrets.token_hex(32))"`
FLASK_SECRET=remplace_moi_par_32_caracteres_aleatoires_minimum

# Durée d'une session web (heures). Au-delà, re-login.
SESSION_LIFETIME_HOURS=24

# Mettre à 1 si le dashboard tourne derrière nginx + HTTPS Let's Encrypt.
# Active les Secure cookies + redirect HTTPS dans Flask.
HTTPS_ENABLED=0

# Flask debug (jamais 1 en prod, sinon double-process et port collisions)
FLASK_DEBUG=0
