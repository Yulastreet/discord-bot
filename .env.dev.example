# ============================================================
# .env.dev — environnement DEV LOCAL (Windows)
# Copie ce fichier en .env.dev et remplis les valeurs.
# Le bot dev tourne avec son propre token Discord et sa propre DB
# pour ne JAMAIS toucher a la prod Hetzner.
# ============================================================

# === Bot Discord DEV (second token) ===
# 1. https://discord.com/developers/applications -> New Application "TookBot Dev"
# 2. Bot tab -> Reset Token -> copie ici
DISCORD_TOKEN=

# Owner ID = ton compte Discord (clic droit sur ton pseudo > Copier ID)
DISCORD_OWNER_ID=

# === Dashboard web DEV (port different de prod) ===
WEB_PORT=5001
WEB_PASSWORD=devpassword
FLASK_SECRET=dev_secret_change_me

# OAuth Discord (peut etre les memes que prod si redirect URI inclut localhost)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# IMPORTANT : enregistre http://localhost:5001/oauth/callback dans le Dev Portal
OAUTH_REDIRECT_URI=http://localhost:5001/oauth/callback

# === Base de donnees DEV ===
# Fichier separe pour pas polluer la DB prod
DB_PATH=bot_database_dev.db

# === SKUs Discord (laisser vide en dev, achats simulés via /grant) ===
SKU_NIVEAU_PREMIUM=
SKU_PASS=
SKU_GUILD_BOOST_PLUS=
SKU_GUILD_BOOST_DUO=
SKU_GUILD_BOOST_SQUAD=
SKU_TOOKBOT_PLUS=

# === Stripe (mode TEST seulement en dev) ===
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_TOOKBOT_PLUS_1M=price_test_...
STRIPE_PRICE_TOOKBOT_PLUS_3M=price_test_...
STRIPE_PRICE_TOOKBOT_PLUS_6M=price_test_...
STRIPE_PRICE_TOOKBOT_PLUS_12M=price_test_...

# === Spotify ===
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# === Pas besoin du proxy WARP/Privoxy ni bgutil en dev local ===
YT_PROXY=
FFMPEG_HTTP_PROXY=
BGUTIL_POT_URL=http://127.0.0.1:4416

# === Marqueur env (utilise par dev_launcher pour afficher 'DEV' partout) ===
TOOKBOT_ENV=dev
